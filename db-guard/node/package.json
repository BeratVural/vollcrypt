{
  "name": "@vollcrypt/db-guard",
  "version": "1.0.1",
  "description": "Database field-level encryption integrations for Vollcrypt (Prisma, Mongoose, Drizzle, TypeORM)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vollcrypt-db-guard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./mongoose": {
      "types": "./dist/mongoose.d.ts",
      "default": "./dist/mongoose.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm.d.ts",
      "default": "./dist/typeorm.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "compliance-config.json",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "LICENSE-GPL"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeratVural/vollcrypt.git",
    "directory": "db-guard/node"
  },
  "author": "Berat Vural <berat.vural.tr@gmail.com>",
  "license": "GPL-3.0-only OR LicenseRef-Commercial",
  "bugs": {
    "url": "https://github.com/BeratVural/vollcrypt/issues"
  },
  "homepage": "https://github.com/BeratVural/vollcrypt/tree/main/db-guard/node#readme",
  "scripts": {
    "build": "tsc && node scripts/generate-sbom.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration:prepare": "prisma generate --schema tests/integration/prisma/schema.prisma && prisma db push --schema tests/integration/prisma/schema.prisma --skip-generate",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": ">=3.0.0",
    "@google-cloud/kms": ">=3.0.0",
    "@prisma/client": ">=4.7.0",
    "drizzle-orm": ">=0.28.0",
    "mongoose": ">=6.0.0",
    "node-vault": ">=0.9.0",
    "pkcs11js": ">=1.0.0",
    "typeorm": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@google-cloud/kms": {
      "optional": true
    },
    "node-vault": {
      "optional": true
    },
    "pkcs11js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "mongoose": "^9.9.2",
    "pg": "^8.22.0",
    "prisma": "^5.0.0",
    "tsx": "^4.7.0",
    "typeorm": "^1.1.0",
    "typescript": "^5.5.2"
  }
}
